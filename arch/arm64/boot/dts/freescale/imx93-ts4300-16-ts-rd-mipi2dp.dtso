/dts-v1/;
/plugin/;
#include <dt-bindings/gpio/gpio.h>

&{/} {
	clk_dp: clk-dp {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <19200000>;
	};

	video_mux: mux-controller {
		compatible = "gpio-mux";
		#mux-state-cells = <0>;
		mux-gpios = <&fpga_gpio0 7 GPIO_ACTIVE_HIGH>;
		idle-state = <0>;
	};
};

&dphy {
	status = "okay";
};

&dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;

			dsi_to_dp: endpoint {
				remote-endpoint = <&dp_to_dsi>;
				data-lanes = <1 2>;
			};
		};
	};
};

&lcdif {
	status = "okay";
	assigned-clock-rates = <445333333>, <148444444>, <400000000>, <133333333>;
};

&lpi2c1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	dp_bridge_onboard: dp-bridge@68 {
		compatible = "toshiba,tc358767"; 
		reg = <0x68>;
		reset-gpios = <&fpga_gpio2 17 GPIO_ACTIVE_LOW>;

		clock-names = "ref";
		clocks = <&clk_dp>;

		toshiba,hpd-pin = <0>;
		status = "okay";
		mux-states = <&video_mux 0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				dp_to_dsi: endpoint {
					remote-endpoint = <&dsi_to_dp>;
				};
			};
		};
	};
};

&media_blk_ctrl {
	status = "okay";
};
